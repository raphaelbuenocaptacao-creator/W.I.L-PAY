{
  "schema_version": 6,
  "project": "wilpay",
  "environment": "production",
  "isolation": {
    "exclusive": true,
    "forbidden_shared_projects": ["captapro", "gamificacao"],
    "database_provider": "neon",
    "database_project_id": null,
    "database_org_id": null,
    "approved_exclusive_database_project_ids": [],
    "approved_exclusive_database_org_ids": [],
    "storage_bucket": "wilpay-private-documents",
    "storage_private": true,
    "storage_provider": null,
    "storage_resource_id": null,
    "storage_provider_binding": null,
    "approved_exclusive_storage_resource_ids": [],
    "approved_exclusive_storage_bindings": [],
    "storage_identity_lock": {
      "immutable_after_approval": true,
      "provider_identity_required": true,
      "resource_identity_required": true,
      "bucket_name_immutable": true
    },
    "storage_layout": {
      "root_prefix": "wilpay/production",
      "object_key_template": "wilpay/production/{auth_uid}/{category}/{file_id}",
      "allowed_categories": ["documents", "selfies", "receipts", "guarantees", "history"],
      "immutable_file_id_required": true,
      "pii_in_object_key_forbidden": true,
      "write_prefix_must_match_root": true,
      "writes_outside_root_forbidden": true
    }
  },
  "capacity": {
    "minimum_complete_clients": 1000,
    "planning_budget_bytes_per_client": 268435456,
    "minimum_planning_budget_bytes": 268435456000,
    "max_object_bytes_by_category": {
      "documents": 15728640,
      "selfies": 10485760,
      "receipts": 10485760,
      "guarantees": 20971520,
      "history": 15728640
    }
  },
  "retention": {
    "automatic_destructive_deletion": false,
    "versioning_required_when_supported": true,
    "metadata_history_required": true,
    "lifecycle_deletion_requires_explicit_approval": true
  },
  "data_policy": {
    "database_binary_payloads": false,
    "database_stores_metadata_only": true,
    "private_storage_required_for_new_uploads_when_bound": true
  },
  "readiness": {
    "status": "BLOCKED_EXTERNAL_BINDING",
    "requires": [
      "exclusive_neon_project_id",
      "exclusive_neon_org_id",
      "private_storage_provider_identity",
      "private_storage_resource_id",
      "private_storage_provider_binding",
      "explicit_resource_approval"
    ]
  }
}
